# Local development configuration names only. Do not commit real credentials.
DATABASE_URL=postgresql+psycopg://prufai:prufai_local_only@localhost:5432/prufai
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=prufai-local
OBJECT_STORAGE_ACCESS_KEY=prufai_local_only
OBJECT_STORAGE_SECRET_KEY=prufai_local_only
# Standards retain their explicit development default. Actual candidate audio
# requires OBJECT_STORAGE_BACKEND=s3 and a reachable private bucket.
OBJECT_STORAGE_BACKEND=memory
# Provision with: bash scripts/setup-media-runtime.sh
AUDIO_MEDIA_RUNTIME=docker
AUDIO_MEDIA_IMAGE=prufai-media:ffmpeg-6.1.1
AUDIO_PROBE_TIMEOUT_SECONDS=15
AUDIO_PROBE_MEMORY_MB=512
# Separate transcription worker; external processing remains closed until the
# exact profile/configuration and deployment processing arrangements are approved.
# See docs/transcription-execution.md. Never store the credential in profile JSON.
SPEECH_TRANSCRIPTION_TEST_ADAPTER_ENABLED=false
SPEECH_TRANSCRIPTION_PROVIDER_TIMEOUT_SECONDS=45
SPEECH_TRANSCRIPTION_APPROVED_PROFILE_FINGERPRINTS=[]
# PRUFAI_SPEECH_OPENAI_API_KEY is supplied by the deployment secret manager only.
# Separate Writing proposal worker. Registry approval alone does not authorize
# external candidate-data processing. See docs/ai-writing-proposals.md.
WRITING_TEST_ADAPTER_ENABLED=false
WRITING_PROVIDER_TIMEOUT_SECONDS=60
WRITING_APPROVED_PROFILE_FINGERPRINTS=[]
# PRUFAI_WRITING_OPENAI_API_KEY is supplied by the deployment secret manager only.
# Separate AUDIO-only Speaking worker. Genuine audio transfer requires an
# independently approved exact deployment and explicit GLOBAL processing policy.
# See docs/ai-speaking-proposals.md. No cloud credentials belong in registry JSON.
SPEAKING_TEST_ADAPTER_ENABLED=false
SPEAKING_PROVIDER_TIMEOUT_SECONDS=90
SPEAKING_APPROVED_PROFILE_FINGERPRINTS=[]
# PRUFAI_SPEAKING_AZURE_OPENAI_API_KEY and
# PRUFAI_SPEAKING_AZURE_MANAGEMENT_TOKEN are deployment secret-manager values only.
AUTH_JWT_SECRET=replace-with-a-random-32-byte-secret
AUTH_JWT_ISSUER=prufai-api
AUTH_JWT_AUDIENCE=prufai-web
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_BACKEND=memory
AUTH_ALLOWED_ORIGINS=["http://localhost:3000"]
POSTGRES_USER=prufai
POSTGRES_PASSWORD=prufai_local_only
POSTGRES_DB=prufai
MINIO_ROOT_USER=prufai_local_only
MINIO_ROOT_PASSWORD=prufai_local_only

# Optional V1 assessment scope. DISABLED keeps the regular application profile.
# BERLIN_LID_LOCKED denies delivery until E03A can verify an approved manifest.
# BERLIN_LID_SYNTHETIC is restricted to the disposable acceptance database.
V1_PILOT_PROFILE=DISABLED
